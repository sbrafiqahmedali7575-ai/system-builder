# Public app URL used in reminder/review links
APP_BASE_URL=https://systembuilder08.ai.studio

# Private owner login key (minimum 16 characters)
APP_ACCESS_KEY=

# HMAC secret for signed email/review links (minimum 32 characters)
CONFIRMATION_SECRET=

# Secret used only by the external scheduler/GitHub Action
SCHEDULER_SECRET=

# Gmail SMTP
EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional outside Google-managed runtimes.
# In Cloud Run / Google-managed hosting, Application Default Credentials are preferred.
# FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"..."}
FIREBASE_SERVICE_ACCOUNT_JSON=
