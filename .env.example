# Required in production to access administrative verification/export endpoints.
# Send this value in the x-system-builder-admin-token request header.
SYSTEM_BUILDER_ADMIN_TOKEN=

# Optional: enables the Data Analytics AI chat. Without it, the UI uses the built-in local analytics fallback.
GEMINI_API_KEY=
SYSTEM_BUILDER_ANALYTICS_MODEL=gemini-3.8-flash
# Optional: set a stronger model for complex correlation, forecasting, anomaly, and root-cause questions.
SYSTEM_BUILDER_ANALYTICS_DEEP_MODEL=
