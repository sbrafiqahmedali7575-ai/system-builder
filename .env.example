# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_BASE_URL: Public production URL for email confirmation links.
# Never use localhost or private dynamic dev URLs.
APP_BASE_URL="https://rafiqcommitdaily.ai.studio"

# GMAIL SMTP CONFIGURATION:
# Uses Gmail SMTP on Port 587 with STARTTLS encryption.
# Never expose these credentials in frontend code or browser requests.
EMAIL_FROM="sbrafiqahmedali7575@gmail.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="sbrafiqahmedali7575@gmail.com"
