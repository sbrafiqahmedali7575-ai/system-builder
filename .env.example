# CONFIRMATION_SECRET: Cryptographic secret used to sign secure, expiring confirmation links.
CONFIRMATION_SECRET="commit-daily-rafiq-secure-token-secret-2026-auth-sign"

# SCHEDULER_SECRET: Secret Bearer token protecting POST /api/send-daily-reminder from unauthorized access.
# External schedulers (e.g. Google Cloud Scheduler, cron-job.org, curl) must pass Authorization: Bearer <SCHEDULER_SECRET>
SCHEDULER_SECRET="commit-daily-scheduler-secret-auth-key-2026"
