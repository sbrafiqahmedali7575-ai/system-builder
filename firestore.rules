rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.uid == 'system-builder-owner'
        && request.auth.token.role == 'owner';
    }

    match /records/{recordId} {
      allow read, write: if isOwner();
    }

    match /tasks/{taskId} {
      allow read, write: if isOwner();
    }

    // Server-only collections. Firebase Admin bypasses Firestore Security Rules.
    match /notification_settings/{document=**} {
      allow read, write: if false;
    }

    match /delivery_logs/{document=**} {
      allow read, write: if false;
    }

    match /confirmation_tokens/{document=**} {
      allow read, write: if false;
    }

    match /daily_reminders_sent/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
