rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global shared records accessible from any device via the web link
    match /records/{recordId} {
      allow read, write: if true;
    }
    match /tasks/{taskId} {
      allow read, write: if true;
    }
    match /habits/{habitId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    match /days/{dateKey} {
      allow read, write: if true;
    }
    match /habitLogs/{habitLogId} {
      allow read, write: if true;
    }
    match /countdowns/{countdownId} {
      allow read, write: if true;
    }
  }
}
